# Python bytecode cache (prevents pytest's __pycache__/.pyc files from being tracked)
__pycache__/
*.pyc
*.pyo
*.pyd

# Pytest cache directories (also generated by `pytest --cacheprovider` and similar)
.pytest_cache/

# Runtime scratch and local state (never committed; telemetry lives on its own branch)
.tmp/
logs/
.do-harness/
.opencode/

# Local credentials. `.env.example` is the template and IS tracked; a filled-in
# `.env` is not, and never may be — this repository is public and the file holds
# a calendar API key. `rehearse.py --env-file` reads it explicitly.
.env
.env.*
!.env.example

# Editor / OS detritus
.DS_Store
.vscode/
.idea/
*.swp
*.swo
.agents/events/
